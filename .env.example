# Only needed for real migrations. The demo, the mock server and the tests need no keys.
# Source Dify service API base URL, e.g. http://localhost/v1
DIFY_SRC_API_URL=
# Source Knowledge API key (dataset-...). Read from the environment only.
DIFY_SRC_API_KEY=
# Target Dify service API base URL
DIFY_DST_API_URL=
# Target Knowledge API key
DIFY_DST_API_KEY=
# UI language: en or ko (optional)
DIFY_KB_PORT_LANG=
